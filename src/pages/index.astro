---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="chinim-internet — почему не работает и как исправить"
  description="Простые разборы частых проблем с доступом к сайтам и приложениям: почему не открывается, что делать, как настроить."
>
  <section class="hero">
    <h1>Что-то не открывается? Спокойно, разберёмся.</h1>
    <p>Простые разборы, почему сайты и приложения тормозят или не работают — и что можно сделать за пару минут.</p>
  </section>

  <div class="list-label">Свежие разборы</div>

  {articles.length === 0 && (
    <p class="empty">Статей пока нет. Скоро здесь появятся первые разборы.</p>
  )}

  <ul class="article-list">
    {articles.map((article) => (
      <li>
        <a class="card" href={`/${article.id}/`}>
          <span class="card-dot" aria-hidden="true"></span>
          <span class="card-body">
            <span class="card-title">{article.data.title}</span>
            <span class="card-desc">{article.data.description}</span>
            <span class="card-date">
              {article.data.pubDate.toLocaleDateString('ru-RU', {
                day: 'numeric', month: 'long', year: 'numeric',
              })}
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
