---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Берём все не-черновые статьи, свежие сверху.
const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="chinim-internet — почему не работает и как исправить"
  description="Простые разборы частых проблем с доступом к сайтам и приложениям: почему не открывается, что делать, как настроить."
>
  <h1>Свежие разборы</h1>

  {articles.length === 0 && (
    <p class="empty">Статей пока нет. Скоро здесь появятся первые разборы.</p>
  )}

  <ul class="article-list">
    {articles.map((article) => (
      <li>
        <a href={`/${article.id}/`}>
          <span class="article-title">{article.data.title}</span>
          <span class="article-desc">{article.data.description}</span>
          <span class="article-date">
            {article.data.pubDate.toLocaleDateString('ru-RU', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })}
          </span>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>
